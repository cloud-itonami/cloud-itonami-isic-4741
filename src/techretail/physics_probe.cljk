(ns techretail.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  trade-in device free-fall drop/shock simulation
  (`techretail.robotics/run-drop-simulation`, IEC 60068-2-31/-32 family)
  over the device classes and fixture masses this actor knows and print
  ONE EDN map of the physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-4741/SOUL.md)
  reads every tick. Every number is derived from a time-stepped trajectory
  by `techretail.robotics`, never typed in. Output schema
  `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-4741\"
     :procedure \"...\"
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n               ; runs that produced numeric quantities
     :expected  n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [techretail.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep
  "Device class x mass swept each tick: the five trade-in units
  `techretail.store` seeds (laptop 1.4 and 1.1 kg, desktop-tower 8.5 kg,
  monitor 6.0 kg, desktop-mini 3.5 kg -- the over-shock unit) plus the one
  class `robotics/device-give-m` defines that no fixture uses (:handheld,
  no mass on file, so the simulation's own default applies)."
  [{:device-class :laptop        :device-mass-kg 1.4}
   {:device-class :laptop        :device-mass-kg 1.1}
   {:device-class :desktop-tower :device-mass-kg 8.5}
   {:device-class :monitor       :device-mass-kg 6.0}
   {:device-class :desktop-mini  :device-mass-kg 3.5}
   {:device-class :handheld}])

(defn- run-one [unit]
  (let [t (robotics/drop-test-telemetry-for unit)
        x (robotics/crosscheck unit)]
    {:input unit
     :quantities (assoc t
                        :closed-form-decel-g (:closed-form-decel-g x)
                        :sim-over-closed-form (:ratio x))
     :out-of-tolerance? (robotics/drop-test-impact-out-of-tolerance? t)}))

(defn probe []
  (let [runs (mapv run-one sweep)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-impact-decel-g])))
        decel (fn [r] (get-in r [:quantities :sim-impact-decel-g]))
        laptops (filter #(= :laptop (get-in % [:input :device-class])) runs)
        ratios (map #(get-in % [:quantities :sim-over-closed-form]) runs)]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-4741"
     :procedure "IEC 60068-2-31/-32 style 1.0 m free-fall drop/shock test of a trade-in device (robot drop-test cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:decel-ceiling-g robotics/decel-ceiling-g
               :worst-class (get-in (apply max-key decel runs) [:input :device-class])
               :laptop-mass-spread-g (- (apply max (map decel laptops)) (apply min (map decel laptops)))
               :sim-over-closed-form-range [(apply min ratios) (apply max ratios)]}
     :count (count (filter numeric? runs))
     :expected (count sweep)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
